# ==============================================================================
# KONFIGURASI APACHE .HTACCESS UNTUK HOSTINGER & CPANEL
# Puskesmas Kepulauan Seribu Selatan
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Paksa Protokol Aman HTTPS (SSL)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. ANTISIPASI LAYAR BLANK PUTIH JIKA DITARIK DARI GIT REPOSITORI:
  # Jika file yang diminta adalah /src/main.tsx atau /src/main.jsx,
  # alihkan langsung ke bundle produksi /assets/app.js!
  RewriteRule ^src/main\.(tsx|jsx|js|ts)$ /assets/app.js [L]
  RewriteRule ^src/index\.css$ /assets/app.css [L]

  # 3. Routing Single Page Application (SPA)
  # Jangan redirect file fisik yang ada (seperti file api/, assets/, banners/, .php, .js, .css)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# MIME Types yang tepat agar browser mengeksekusi modul javascript
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

# ==============================================================================
# OPTIMISASI PERFORMA & KOMPRESI (GZIP / MOD_DEFLATE)
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==============================================================================
# BROWSER CACHING (MEMPERCEPAT LOADING PENGUNJUNG KEPULAUAN)
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Keamanan Dasar
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
